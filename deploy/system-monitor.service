[Unit]
Description=CPU and memory metrics collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/monitor_deploy
EnvironmentFile=%h/.config/system-monitor.env
ExecStart=%h/monitor_deploy/system_monitor_app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
